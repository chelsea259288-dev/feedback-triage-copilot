{
  "name": "feedback-hub",
  "version": "1.0.0",
  "description": "Cloudflare 产品反馈智能分析平台",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create feedback_db",
    "db:migrate": "wrangler d1 execute feedback_db --file=./migrations/0001_initial_schema.sql",
    "db:migrate:local": "wrangler d1 execute feedback_db --local --file=./migrations/0001_initial_schema.sql",
    "kv:create": "wrangler kv:namespace create CACHE"
  },
  "keywords": ["cloudflare", "workers", "ai", "feedback", "analytics"],
  "author": "Chelsea Xiao",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.95.0"
  }
}
